  "repository": {
    "type": "git",
    "url": "git+https://github.com/kahlelhawary-art/escpos-arabic.git"
  },
  "homepage": "https://github.com/kahlelhawary-art/escpos-arabic#readme",
  "bugs": "https://github.com/kahlelhawary-art/escpos-arabic/issues",
